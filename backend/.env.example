APP_NAME=KOMPAS API
ENV=development
DEMO_MODE=true

# Keep SQLite for local/demo usage. Use PostgreSQL in production.
DATABASE_URL=sqlite:///./backend/kompas.db
SESSION_SECRET=replace-this-with-a-long-random-secret-of-32-plus-chars
SESSION_TTL_HOURS=8

# --- AI opsional: Jev (TypeSafe) lewat OpenRouter ---------------------------
# Mati bawaan; mesin aturan sudah menjalankan semua fungsi MVP tanpa internet.
# 1. Buat key di https://openrouter.ai/keys (format sk-or-v1-...)
# 2. Isi OPENROUTER_API_KEY di bawah, ubah JEV_ENABLED=true, lalu restart backend.
# File backend/.env sudah masuk .gitignore; JANGAN commit key asli.
JEV_ENABLED=false
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14
JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
# Proposal 4.2: batas 2 detik + 1x ulang; 3 gagal beruntun -> jeda 10 menit.
JEV_TIMEOUT_MS=2000
JEV_RETRIES=1
JEV_BREAKER_FAILURES=3
JEV_BREAKER_COOLDOWN_S=600

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
