APP_NAME=KOMPAS API
ENV=development
DEMO_MODE=true

# Keep SQLite for local/demo usage. Use PostgreSQL in production.
DATABASE_URL=sqlite:///./backend/kompas.db
SESSION_SECRET=replace-this-with-a-long-random-secret
SESSION_TTL_HOURS=8

# Optional Jev/TypeSafe integration. Rule-based mode works without these values.
JEV_ENABLED=false
JEV_API_KEY=
JEV_API_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=8000

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
