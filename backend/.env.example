APP_NAME=KOMPAS API
ENV=development
DEMO_MODE=true

# Keep SQLite for local/demo usage. Use PostgreSQL in production.
DATABASE_URL=sqlite:///./backend/kompas.db
SESSION_SECRET=replace-this-with-a-long-random-secret-of-32-plus-chars
SESSION_TTL_HOURS=8

# --- PRODUKSI (DEMO_MODE=false) ------------------------------------------------
# Backend menolak menyala bila SESSION_SECRET masih nilai contoh / <32 karakter,
# atau SEED_USER_PASSWORD kosong. Login berkata sandi menggantikan pemilih peran.
# SEED_USER_PASSWORD=ganti-dengan-kata-sandi-awal-yang-kuat

# --- AI opsional: Jev (TypeSafe) lewat OpenRouter ---------------------------
# Mati bawaan; mesin aturan sudah menjalankan semua fungsi MVP tanpa internet.
# 1. Buat key di https://openrouter.ai/keys (format sk-or-v1-...)
# 2. Isi OPENROUTER_API_KEY di bawah, ubah JEV_ENABLED=true, lalu restart backend.
# File backend/.env sudah masuk .gitignore; JANGAN commit key asli.
JEV_ENABLED=false
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14
JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
# Proposal 4.2: batas 2 detik + 1x ulang; 3 gagal beruntun -> jeda 10 menit.
# Ambang "menaikkan kewaspadaan": dikalibrasi dari 100 panggilan Jev asli (Golden Set 100).
JEV_RAISE_THRESHOLD=0.8
# Batas panggilan Jev per menit (kontrol biaya) dan cache pesan identik.
JEV_MAX_CALLS_PER_MINUTE=120
JEV_CACHE_TTL_S=600
JEV_TIMEOUT_MS=2000
JEV_RETRIES=1
JEV_BREAKER_FAILURES=3
JEV_BREAKER_COOLDOWN_S=600

ALLOWED_ORIGINS=https://kompasdev.my.id,https://www.kompasdev.my.id,http://localhost:3000,http://127.0.0.1:3000
