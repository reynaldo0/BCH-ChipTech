APP_NAME=KOMPAS API
ENV=production
DEMO_MODE=false

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-64-character-random-secret
SESSION_TTL_HOURS=8
SEED_USER_PASSWORD=replace-with-a-strong-initial-password

ALLOWED_ORIGINS=https://kompasdev.my.id,https://www.kompasdev.my.id,http://localhost:3000,http://127.0.0.1:3000

JEV_ENABLED=false
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14
JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
JEV_RAISE_THRESHOLD=0.8
JEV_MAX_CALLS_PER_MINUTE=120
JEV_CACHE_TTL_S=600
JEV_TIMEOUT_MS=2000
JEV_RETRIES=1
JEV_BREAKER_FAILURES=3
JEV_BREAKER_COOLDOWN_S=600
